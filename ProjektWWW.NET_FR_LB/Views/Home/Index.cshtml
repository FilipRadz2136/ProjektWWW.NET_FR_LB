@{
    ViewData["Title"] = "Strona główna kantoru";
}

<div class="container mt-5">
    <!-- Nagłówek -->
    <div class="text-center mb-5">
        <h1 class="display-4">Witamy w Kantorze Online</h1>
        <p class="lead">Aktualne kursy, szybkie przeliczenia, historia i alerty kursowe</p>
    </div>

    <div class="row">
        <!-- Panel przelicznika -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Przelicznik walut</h5>
                    <!-- formularz przelicznika (do uzupełnienia później) -->
                    <p class="text-muted">[Formularz przelicznika – wkrótce]</p>
                </div>
            </div>
        </div>

        <!-- Panel kursów -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Aktualne kursy</h5>
                    <!-- lista kursów (do uzupełnienia później) -->
                    <p class="text-muted">[Lista najnowszych kursów – wkrótce]</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Alert kursowy -->
    <div class="my-5 text-center">
        <h4>Alerty kursowe</h4>
        <p class="text-muted">[Możliwość ustawienia alertu – wkrótce]</p>
    </div>

    <!-- Historia wymian -->
    <div class="my-5">
        <h4>Historia wymian</h4>
        <p class="text-muted">[Historia użytkownika – tylko po zalogowaniu]</p>
    </div>

    <!-- Źródła kursów -->
    <div class="my-5">
        <h4>Źródła danych</h4>
        <p class="text-muted">[Informacje o źródłach kursów – wkrótce]</p>
    </div>

    <!-- Stopka -->
    <footer class="text-center text-muted mt-5">
        <p>&copy; 2025 Kantor Internetowy | Projekt ASP.NET</p>
    </footer>
</div>
