@model ProjektWWW.NET_FR_LB.Models.Komentarz

@{
    ViewData["Title"] = "Dodaj komentarz";
}

<h2>Dodaj komentarz</h2>

<form asp-action="Dodaj" method="post">
    <div class="form-group">
        <label for="Tresc">Treść komentarza</label>
        <textarea asp-for="Tresc" class="form-control" rows="4" required></textarea>
        <span asp-validation-for="Tresc" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary mt-2">Wyślij</button>
    <a asp-action="Index" class="btn btn-secondary mt-2">Powrót</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
