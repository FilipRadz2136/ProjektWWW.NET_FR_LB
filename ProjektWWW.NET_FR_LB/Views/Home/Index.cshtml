@{
    ViewData["Title"] = "Strona główna";
}
<h2 class="text-center mt-4 mb-5">
    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="#0d6efd" class="bi bi-currency-exchange me-2" viewBox="0 0 16 16" style="vertical-align:middle;">
        <path d="M8 0a8 8 0 1 0 8 8A8 8 0 0 0 8 0zm0 15A7 7 0 1 1 15 8 7 7 0 0 1 8 15z"/>
        <path d="M11.5 8a.5.5 0 0 1-.5.5H8.707l1.147 1.146a.5.5 0 0 1-.708.708l-2-2a.5.5 0 0 1 0-.708l2-2a.5.5 0 1 1 .708.708L8.707 7.5H11a.5.5 0 0 1 .5.5z"/>
    </svg>
    Witaj w internetowym kantorze walut!
</h2>
<div class="container mt-3">
    <div class="row row-cols-1 row-cols-md-2 g-5 justify-content-center">
        <div class="col">
            <a asp-controller="Kursy" asp-action="Wykres" style="text-decoration:none;">
                <div class="card shadow-lg border-0 h-100" style="cursor:pointer; transition: transform 0.2s; font-size:1.25rem; min-height: 260px;" onmouseover="this.style.transform='scale(1.06)'" onmouseout="this.style.transform='scale(1)'">
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" fill="#0d6efd" class="bi bi-graph-up" viewBox="0 0 16 16">
                                <path d="M0 0h1v15h15v1H0V0zm14.293 3.707l-4.147 4.146-2.146-2.147a.5.5 0 0 0-.708 0l-4 4 .708.708L7.5 6.207l2.146 2.147a.5.5 0 0 0 .708 0l4.5-4.5-.707-.707z"/>
                            </svg>
                        </div>
                        <h5 class="card-title mb-2"><b>Wykresy kursów</b></h5>
                        <span class="text-muted">Zobacz wykresy zmian kursów walut</span>
                    </div>
                </div>
            </a>
        </div>
        <div class="col">
            <a asp-controller="Home" asp-action="NowyWidok" style="text-decoration:none;">
                <div class="card shadow-lg border-0 h-100" style="cursor:pointer; transition: transform 0.2s; font-size:1.25rem; min-height: 260px;" onmouseover="this.style.transform='scale(1.06)'" onmouseout="this.style.transform='scale(1)'">
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" fill="#0d6efd" class="bi bi-search" viewBox="0 0 16 16">
                                <path d="M11 6a5 5 0 1 1-10 0 5 5 0 0 1 10 0zm-1.293 6.707a1 1 0 0 1-1.414 0l-3.5-3.5a1 1 0 0 1 1.414-1.414l3.5 3.5a1 1 0 0 1 0 1.414z"/>
                            </svg>
                        </div>
                        <h5 class="card-title mb-2"><b>Wyszukiwarka kursów</b></h5>
                        <span class="text-muted">Znajdź walutę i zobacz jej wykres</span>
                    </div>
                </div>
            </a>
        </div>
        <div class="col">
            <a asp-controller="Kursy" asp-action="AktualnyKurs" style="text-decoration:none;">
                <div class="card shadow-lg border-0 h-100" style="cursor:pointer; transition: transform 0.2s; font-size:1.25rem; min-height: 260px;" onmouseover="this.style.transform='scale(1.06)'" onmouseout="this.style.transform='scale(1)'">
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" fill="#0d6efd" class="bi bi-currency-exchange" viewBox="0 0 16 16">
                                <path d="M8 0a8 8 0 1 0 8 8A8 8 0 0 0 8 0zm0 15A7 7 0 1 1 15 8 7 7 0 0 1 8 15z"/>
                                <path d="M11.5 8a.5.5 0 0 1-.5.5H8.707l1.147 1.146a.5.5 0 0 1-.708.708l-2-2a.5.5 0 0 1 0-.708l2-2a.5.5 0 1 1 .708.708L8.707 7.5H11a.5.5 0 0 1 .5.5z"/>
                            </svg>
                        </div>
                        <h5 class="card-title mb-2"><b>Przelicznik walut</b></h5>
                        <span class="text-muted">Przelicz kursy walut online</span>
                    </div>
                </div>
            </a>
        </div>
        <div class="col">
            <a asp-controller="Alerty" asp-action="Lista" style="text-decoration:none;">
                <div class="card shadow-lg border-0 h-100" style="cursor:pointer; transition: transform 0.2s; font-size:1.25rem; min-height: 260px;" onmouseover="this.style.transform='scale(1.06)'" onmouseout="this.style.transform='scale(1)'">
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" fill="#0d6efd" class="bi bi-bell" viewBox="0 0 16 16">
                                <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2zm.104-14.804A1.5 1.5 0 0 0 6.5 2c0 .628.134 1.197.354 1.684C4.885 4.36 4 5.5 4 7v3.5l-.964 1.607A.5.5 0 0 0 3.5 13h9a.5.5 0 0 0 .464-.707L12 10.5V7c0-1.5-.885-2.64-2.854-3.316A3.5 3.5 0 0 0 8.104 1.196z"/>
                            </svg>
                        </div>
                        <h5 class="card-title mb-2"><b>Alerty kursowe</b></h5>
                        <span class="text-muted">Ustaw powiadomienia o zmianie kursu</span>
                    </div>
                </div> 
            </a>
        </div>
    </div>
</div>