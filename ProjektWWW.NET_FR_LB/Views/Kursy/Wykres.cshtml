@{
    ViewData["Title"] = "Wykres kursów walut";
}
<h2>Wykres kursów walut</h2>
<canvas id="kursChart" width="800" height="400"></canvas>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
fetch('/Kursy/HistoriaKursowWszystkich?dni=30')
    .then(res => res.json())
    .then(data => {
        const ctx = document.getElementById('kursChart').getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: data.labels,
                datasets: data.datasets
            }
        });
    });
</script>